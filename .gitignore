# .gitignore for AI Resume Intelligence System 2.0

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
venv*/
env/
.env

# Database
*.sqlite
*.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!variables.tf
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Environment files — NEVER commit
.env
.env.*
!.env.example

# Docker
*.log

# Sentence-transformers model cache
.cache/

# Uploaded resumes (don't commit user data)
uploads/
