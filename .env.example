# ==========================================
# Environment Variables — EXAMPLE FILE
# ==========================================
# Copy this file to `.env` and fill in real values:
#
#   cp .env.example .env
#
# `.env` is gitignored. NEVER commit real secrets.
# ==========================================

# ---------- APPLICATION ----------
# development | staging | production
# In production the app REQUIRES JWT_SECRET_KEY and ADMIN_PASSWORD_HASH,
# and disables /docs. Set this to "production" for any public deployment.
ENVIRONMENT=development

# ---------- DATABASE ----------
# Optional. Defaults to /app/backend/data/resume_db.sqlite inside Docker,
# or the backend/ directory when running locally.
# DATABASE_PATH=/app/backend/data/resume_db.sqlite

# ---------- AUTHENTICATION ----------
# Generate a strong secret:  openssl rand -base64 32
JWT_SECRET_KEY=

# How long a login token stays valid (hours)
JWT_EXPIRATION_HOURS=24

ADMIN_USERNAME=admin

# Bcrypt hash of the admin password. Generate it with:
#   cd backend
#   python -c "from auth import hash_password; print(hash_password('YourStrongPassword'))"
# NEVER put the plaintext password here.
ADMIN_PASSWORD_HASH=

# ---------- CORS ----------
# Comma-separated list of allowed frontend origins.
# Required in production. Example: https://resume.example.com
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# ---------- RATE LIMITING ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_UPLOAD_REQUESTS=10
RATE_LIMIT_MATCH_REQUESTS=20

# ---------- FILE UPLOAD LIMITS ----------
MAX_FILE_SIZE_MB=10
MAX_BATCH_SIZE=20
MAX_PDF_PAGES=50

# ---------- MONITORING ----------
PROMETHEUS_ENABLED=true
